{
  "expo": {
    "name": "cssp-mobile",
    "slug": "cssp-mobile",
    "version": "1.0.0",
    "scheme": "cssp-mobile",
    "platforms": ["ios", "android"],
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "orientation": "portrait",
    "icon": "./src/shared/assets/images/logo.jpg",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/shared/assets/images/logo.jpg",
        "backgroundColor": "#ffffff"
      }
    }
  }
}
