  "cards": [
    {
      "dot": "cyan",
      "title": "Phase State Machine",
      "items": [
        "camera \u2192 live feed with blink-liveness checks",
        "capturing \u2192 native capture + compress to \u2264 500 KB",
        "preview \u2192 approve or retake (registration mode only)",
        "submitting \u2192 loading spinner while an API call is in flight",
        "result \u2192 server response display (verResponse)",
        "declaration \u2192 NEC/NMC self-declaration form",
        "error \u2192 unrecoverable state, Try Again returns to camera"
      ]
    },
    {
      "dot": "emerald",
      "title": "Camera Liveness Checks",
      "items": [
        "0 faces \u2192 'No Face Detected'",
        ">1 faces \u2192 'Multiple Faces Detected'",
        "|yaw| \u2265 28 or |pitch| \u2265 32 \u2192 'Please look straight'",
        "face center outside 30\u201370% frame \u2192 'Center your face'",
        "face smaller than 20% of frame \u2192 'Move closer to camera'",
        "eyes closed (< 0.35 both) \u2192 'Eyes Closed', then open \u2192 blink",
        "blink detected \u2192 capturePhoto()"
      ]
    },
    {
      "dot": "violet",
      "title": "Capture & Compression",
      "items": [
        "capturePhotoToFile \u2192 phase 'capturing' \u2192 compress (JPEG 0.85 \u2192 0.3) until \u2264 500 KB",
        "base64 payload stripped of whitespace, wrapped as data:image/jpeg",
        "normal mode: single photo submitted as image_1 (image_2 '')",
        "registration mode: 1st photo \u2192 preview, 2nd photo \u2192 preview, then submit both",
        "capture/compress failure deletes temp files and jumps to error"
      ]
    },
    {
      "dot": "rose",
      "title": "Self-Verification Codes",
      "items": [
        "'00' \u2192 SuccessStatusCard \u00b7 official approval",
        "'22' + no image2 \u2192 RejectStatusCard \u00b7 retake photo",
        "'22' + image2 \u2192 Pending \u00b7 self-declaration",
        "'4' / '04' \u2192 Declaration directly (skips result)",
        "other + image2 \u2192 Pending \u00b7 self-declaration",
        "other + no image2 \u2192 Error ('Verification failed')"
      ]
    },
    {
      "dot": "amber",
      "title": "Declaration & DLC",
      "items": [
        "NEC: 'Are you Re-Employed?' always shown",
        "NMC: 'Are you Re-Married?' only when code '4'",
        "empty answer \u2192 snackbar 'Please select Yes or No'",
        "Terms & Conditions confirm dialog before POST /api/lc/",
        "payload: selfVerNec, selfVerNmc, self_ver_code, ver_mode_code '01'",
        "DLC success \u2192 verResponse \u2192 result; failure \u2192 error"
      ]
    }
  ]
