# ============================================================================
# cssp-mobile API playground (VSCode REST Client)
#
# SECURITY NOTICE:
#   - NEVER commit real tokens, passwords, hashes, or encrypted payloads here.
#   - Values are interpolated from your LOCAL .env at request time.
#   - Required .env vars: EXPO_PUBLIC_API_URL, ACCESS_TOKEN, RENEW_TOKEN.
#     After a fresh login, copy token= / renew_token= values into .env and
#     keep .env gitignored.
# ============================================================================

@accessToken = {{ACCESS_TOKEN}}
@renewToken = {{RENEW_TOKEN}}

### Current User
POST {{EXPO_PUBLIC_API_URL}}/current-user/
Content-Type: application/json
Authorization: accessToken {{accessToken}}
Accept: application/json

### Registration Status
POST {{EXPO_PUBLIC_API_URL}}/get_registration_status/
Content-Type: application/json
Accept: application/json

{
  "ppo_no": "{{PPO_NO}}",
  "version": "24"
}

### Create Pensioner
POST {{EXPO_PUBLIC_API_URL}}/api/create_pensioner/
Content-Type: application/json
Authorization: accessToken {{accessToken}}
Accept: application/json

{
  "ppo_no": {{USERNAME_ENCRYPTED}},
  "dob": "{{DOB}}",
  "bank_account_number": "{{BANK_AC_NO}}",
  "password": "{{PPO_NO_ENCRYPTED}}"
}

### Login
POST {{EXPO_PUBLIC_API_URL}}/login/
Content-Type: application/x-www-form-urlencoded
Accept: application/json

password={{PASSWORD_ENCRYPTED}}&username={{USERNAME_ENCRYPTED}}&version=24

### Logout
POST {{EXPO_PUBLIC_API_URL}}/logout/
Content-Type: application/json
Authorization: accessToken {{accessToken}}
Accept: application/json

### Verification
POST {{EXPO_PUBLIC_API_URL}}/api/verification/
Content-Type: application/json
Authorization: accessToken {{accessToken}}
Accept: application/json

{ 
 "image_1":"",// base64 image
 "image_2":"",// base64 image

}

### DLC
POST {{EXPO_PUBLIC_API_URL}}/api/lc/
Content-Type: application/json
Authorization: accessToken {{accessToken}}
Accept: application/json

{
  "selfVerNec": "",
  "selfVerNmc": "",
  "device": "",
  "device_id": "",
  "ver_mode_code": "",
  "self_ver_code": "",
  "place": ""
}

### Verification Status
POST {{EXPO_PUBLIC_API_URL}}/api/verification_status/
Authorization: accessToken {{accessToken}}
Accept: application/json

{
  "ppo_no": "{{PPO_NO}}"
}

### Change Password
POST {{EXPO_PUBLIC_API_URL}}/api/change_password/
Content-Type: application/json
Authorization: accessToken {{accessToken}}
Accept: application/json

{
  "oldPassword": "",
  "newPassword": ""
}

### Validate Token
# @name=refresh token
POST {{EXPO_PUBLIC_API_URL}}/api/validate_token/
Content-Type: application/x-www-form-urlencoded
Authorization: accessToken {{accessToken}}
Accept: application/json

request_token={{REQUEST_TOKEN_ENCRYPTED}}&uid={{UID_ENCRYPTED}}

### Encrypt helper
POST http://localhost:3000/api/cpps/PensionersApp/v1/encrypt
Content-Type: application/json

{ 
    "username":"{{PPO_NO}}",
    "password":"{{FORMATTED_PASSWORD}}"
}

### Decrypt helper
POST http://localhost:3000/api/cpps/PensionersApp/v1/decrypt
Content-Type: application/json

{
  "username":"{{USERNAME_ENCRYPTED}}"
}

### format-password helper
POST http://localhost:3000/api/cpps/PensionersApp/v1/format-password
Authorization: accessToken {{accessToken}}
Content-Type: application/json

{
  "password":"{{PASSWORD}}"
}
