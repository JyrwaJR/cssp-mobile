{
  "name": "cssp-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "dev": "expo start --clear",
    "dev:windows": "set NODE_OPTIONS=--max-old-space-size=4096 && npx expo start --clear",
    "start": "expo start",
    "start:windows": "set NODE_OPTIONS=--max-old-space-size=4096 && npx expo start",
    "prebuild": "expo prebuild",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "web": "expo start --web",
    "web:windows": "set NODE_OPTIONS=--max-old-space-size=4096 && npx expo start --web",
    "clean": "expo start --clear && watchman watch-del-all && rm -rf .expo .cache node_modules/.cache",
    "clean:windows": "expo start --clear && watchman watch-del-all && rmdir /s /q .expo .cache node_modules\\.cache 2>nul || true"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react-native": "^1.0.16",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "expo": "~57.0.15",
    "expo-application": "~57.0.2",
    "expo-constants": "~57.0.14",
    "expo-dev-client": "~57.0.14",
    "expo-device": "~57.0.1",
    "expo-file-system": "^57.0.5",
    "expo-linking": "~57.0.7",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.13",
    "expo-router": "~57.0.15",
    "expo-secure-store": "^57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.16",
    "nativewind": "4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.85.0",
    "react-native": "0.86.2",
    "react-native-css-interop": "^0.2.6",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-vision-camera": "^5.2.3",
    "react-native-vision-camera-face-detector": "^2.0.6",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/base-64": "^1.0.2",
    "@types/crypto-js": "^4.2.2",
    "@types/react": "~19.2.2",
    "eslint": "^9.25.1",
    "eslint-config-expo": "~57.0.1",
    "eslint-config-prettier": "^10.1.2",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "tailwindcss": "^3.4.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
