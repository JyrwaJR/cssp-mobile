# Copy to test/.env and fill in real values. test/.env is gitignored — never
# commit real credentials. All keys are documented here; nothing is required to
# run a subset of flows unless the flow scenario needs it.

# --- Login (required for secure flows via helpers/login.yaml) ---
PPO_NO=                    # registered pensioner PPO number (also prefills login in dev builds)
PASSWORD=                  # password for that account

# --- Registration wizard (required only for flows/auth/registration-*.yaml) ---
# These must match the treasury records returned by the PPO check for REG_PPO_NO.
REG_PPO_NO=                # PPO used by the wizard (Step 1 "Check PPO Status")
REG_ORGANIZATION=          # organization name (Step 2)
REG_DOB=                   # pensioner DOB as DD-MM-YYYY (Step 2) — for family
                           # pensioners this is the deceased primary pensioner DOB
REG_BANK=                  # 16-digit pension bank account number (Step 2)
REG_PASSWORD=              # password created during registration (8-50 chars)

# --- Change password (flows/change-password/*.yaml, ordered per R5) ---
NEW_PASSWORD=Test1234!     # temporary password; success flow sets it, restore flow
                           # reverts to PASSWORD. Default shown; override if needed.

# --- Target app & device ---
APP_ID=com.jyrwajr.csspmobile.dev
MAESTRO_DEVICE=a5da5d01    # adb device serial used by npm test:e2e*

# --- Helper behavior ---
CLEAR_STATE=false          # helpers/launch-app.yaml; true wipes app data before launch